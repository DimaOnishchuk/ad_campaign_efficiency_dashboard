    <worksheet name='Metric Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#192062' fontname='Tableau Book' fontsize='16'><![CDATA[Metric Trend - <[Parameters].[Parameter 0119049897881609]>]]></run>
            <run>Æ&#10;</run>
            <run fontcolor='#235fd9' fontname='Tableau Book' fontsize='16'>■</run>
            <run fontcolor='#000000' fontname='Tableau Book' fontsize='10'> Facebook </run>
            <run fontcolor='#f28850' fontname='Tableau Book' fontsize='16'>■</run>
            <run fontcolor='#000000' fontname='Tableau Book' fontsize='10'> Google</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Onishchuk_Project_2' name='federated.0lj2s6x0hpufpk1d097kr1scmqn2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Metric' datatype='string' name='[Parameter 0119049897881609]' param-domain-type='list' role='measure' type='nominal' value='&quot;CPL&quot;'>
              <calculation class='tableau' formula='&quot;CPL&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0lj2s6x0hpufpk1d097kr1scmqn2'>
            <column caption='CTR' datatype='real' default-format='p0.00%' name='[Calculation_0119049887657984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_clicks])/SUM([total_impressions])' />
            </column>
            <column caption='CPC' datatype='real' name='[Calculation_0119049888108545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_spend])/SUM([total_clicks])' />
            </column>
            <column caption='CPL' datatype='real' name='[Calculation_0119049888473091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_spend])/SUM([leads])' />
            </column>
            <column caption='ROMI' datatype='real' name='[Calculation_0119049889509380]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_value]) - SUM([total_spend]))/SUM([total_spend])' />
            </column>
            <column caption='Clicks to Leads Conversion' datatype='real' name='[Calculation_0119049893380101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([leads])/SUM([total_clicks])' />
            </column>
            <column caption='Reach to Leads Conversion' datatype='real' name='[Calculation_0119049893703686]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([leads])/SUM([total_reach])' />
            </column>
            <column caption='Selected Metric' datatype='real' name='[Calculation_0119049899163658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 0119049897881609]&#13;&#10;    WHEN &quot;CTR&quot; THEN [Calculation_0119049887657984]&#13;&#10;    WHEN &quot;CPC&quot; THEN [Calculation_0119049888108545]&#13;&#10;    WHEN &quot;CPL&quot; THEN [Calculation_0119049888473091]&#13;&#10;    WHEN &quot;ROMI&quot; THEN [Calculation_0119049889509380]&#13;&#10;    WHEN &quot;Clicks to Leads Conversion&quot; THEN [Calculation_0119049893380101]&#13;&#10;    WHEN &quot;Reach to Leads Conversion&quot; THEN [Calculation_0119049893703686]&#13;&#10;END' />
            </column>
            <column caption='Selected Metric (Format)' datatype='string' name='[Calculation_1371668883234820]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 0119049897881609]&#13;&#10;    WHEN &quot;CTR&quot; THEN STR(ROUND([Calculation_0119049887657984]*100, 2)) + &quot;%&quot;      &#13;&#10;    WHEN &quot;CPC&quot; THEN &quot;$&quot; + STR(ROUND([Calculation_0119049888108545], 2))&#13;&#10;    WHEN &quot;CPL&quot; THEN &quot;$&quot; + STR(ROUND([Calculation_0119049888473091], 2))&#13;&#10;    WHEN &quot;ROMI&quot; THEN STR(ROUND([Calculation_0119049889509380]*100, 2)) + &quot;%&quot;      &#13;&#10;    WHEN &quot;Clicks to Leads Conversion&quot; THEN STR(ROUND([Calculation_0119049893380101] * 100, 2)) + &quot;%&quot;&#13;&#10;    WHEN &quot;Reach to Leads Conversion&quot; THEN STR(ROUND([Calculation_0119049893703686] * 100, 2)) + &quot;%&quot;     &#13;&#10;END' />
            </column>
            <column caption='Ad Date' datatype='date' name='[ad_date]' role='dimension' type='ordinal' />
            <column caption='Adset Name' datatype='string' name='[adset_name]' role='dimension' type='nominal' />
            <column caption='Campaign Name' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
            <column caption='Total Leads' datatype='integer' name='[leads]' role='measure' type='quantitative' />
            <column caption='Media Source' datatype='string' name='[media_source]' role='dimension' type='nominal' />
            <column-instance column='[ad_date]' derivation='None' name='[none:ad_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[adset_name]' derivation='None' name='[none:adset_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[campaign_name]' derivation='None' name='[none:campaign_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[media_source]' derivation='None' name='[none:media_source:nk]' pivot='key' type='nominal' />
            <column-instance column='[utm_campaign]' derivation='None' name='[none:utm_campaign:nk]' pivot='key' type='nominal' />
            <column-instance column='[ad_date]' derivation='Month-Trunc' name='[tmn:ad_date:qk]' pivot='key' type='quantitative' />
            <column caption='Total Clicks' datatype='integer' name='[total_clicks]' role='measure' type='quantitative' />
            <column caption='Total Impressions' datatype='integer' name='[total_impressions]' role='measure' type='quantitative' />
            <column caption='Total Reach' datatype='integer' name='[total_reach]' role='measure' type='quantitative' />
            <column caption='Total Spend' datatype='integer' name='[total_spend]' role='measure' type='quantitative' />
            <column caption='Total Value' datatype='integer' name='[total_value]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0119049899163658]' derivation='User' name='[usr:Calculation_0119049899163658:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1371668883234820]' derivation='User' name='[usr:Calculation_1371668883234820:nk]' pivot='key' type='nominal' />
            <column caption='Utm Campaign' datatype='string' name='[utm_campaign]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0lj2s6x0hpufpk1d097kr1scmqn2].[Action (Campaign Name)]'>
            <groupfilter function='level-members' level='[campaign_name]' user:ui-action-filter='[Action1_6CEB3865EA7649A7A74B7702C5256CD6]' user:ui-enumeration='all' user:ui-marker='enumerate' />
